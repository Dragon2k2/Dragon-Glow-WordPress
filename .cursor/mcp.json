{
  "mcpServers": {
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--memoryDebugging=true",
        "--categoryExtensions=true",
        "--categoryExperimentalThirdParty=true",
        "--categoryExperimentalWebmcp=true",
        "--categoryPwa=true",
        "--experimentalVision=true"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    }
  }
}
